#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
BUNDLE_PATH = File.join(APP_ROOT, "vendor", "bundle")
BUNDLE_ENV = {
  "BUNDLE_PATH" => BUNDLE_PATH,
  "GEM_HOME" => BUNDLE_PATH,
  "GEM_PATH" => BUNDLE_PATH
}.freeze

def system!(*args, env: {})
  system(BUNDLE_ENV.merge(env), *args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Keep all project gems inside Ember Vault. This avoids requiring root access
  # and prevents setup from writing into the system Ruby gem directory.
  FileUtils.mkdir_p BUNDLE_PATH

  puts "== Installing dependencies =="
  system(BUNDLE_ENV, "bundle", "check") || system!("bundle", "install")

  puts "\\n== Installing map indexer dependencies =="
  system! "npm", "install", "--prefix", "vendor/map_indexer", "--no-audit", "--no-fund"

  puts "\n== Preparing database =="
  system! "bin/rails", "db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails", "log:clear", "tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec BUNDLE_ENV, "bin/dev"
  end
end
