<div class="wizard-shell"><section class="wizard-step active"><div class="wizard-intro"><p class="section-index">OFFICIAL // KNOWLEDGE PACKS</p><h1>Choose what survives.</h1><p><%= @catalog_result.online ? "Online — showing the current Ember Vault knowledge catalog." : "Offline — installed packs remain available. #{@catalog_result.error}" %></p></div><%= form_with url: install_knowledge_packs_path do %><div class="catalog-sections"><% @categories.each do |category| %><% packs = category.fetch("packages", []).select { |p| @catalog_result.online || @installed.key?(p["id"]) } %><% next if packs.empty? %><section class="catalog-category"><div><small><%= category["slug"] %></small><h2><%= category["name"] %></h2></div><div class="catalog-packages"><% packs.each do |pack| %><% download = @installed[pack["id"]] %><% update = download&.installed_package_version && (pack["version"] != download.installed_package_version || pack["content_hash"] != download.installed_content_hash) %><label class="catalog-package"><%= check_box_tag "packages[]", pack["id"], download&.active?, disabled: !@catalog_result.online || download&.active? %><span><b><%= pack["name"] %></b><p><%= pack["description"] %></p><small><%= number_to_human_size(pack.fetch("download_size", 0)) %> · <%= update ? "UPDATE AVAILABLE" : (download&.status || "AVAILABLE").upcase %><%= " · #{download.progress}%" if download&.active? %></small><%= content_tag(:em, download.error_message) if download&.error_message.present? %></span></label><% end %></div></section><% end %></div><%= submit_tag "DOWNLOAD SELECTED", class: "button button-light", disabled: !@catalog_result.online %><% end %><%= button_to "REFRESH CATALOG", refresh_knowledge_packs_path, class: "button button-ghost" %></section></div>
