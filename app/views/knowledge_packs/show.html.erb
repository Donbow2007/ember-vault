<div class="wizard-shell"><section class="wizard-step active"><div class="wizard-intro"><p class="section-index">OFFICIAL // KNOWLEDGE PACKS</p><h1>Choose what survives.</h1><p><%= @catalog_result.online ? "Online — showing the current Ember Vault knowledge catalog." : "Offline — showing knowledge currently installed on this device." %></p></div><%= form_with url: install_knowledge_packs_path do %><div class="catalog-sections"><% @categories.each do |category| %><% packs = category.fetch("packages", []).select { |p| @catalog_result.online || @installed.key?(p["id"]) } %><% next if packs.empty? %><section class="catalog-category"><div><small><%= category["slug"] %></small><h2><%= category["name"] %></h2></div><div class="catalog-packages"><% packs.each do |pack| %><% installed = @installed[pack["id"]]; update = installed && pack["version"].to_i > installed.package_version.to_i %><label class="catalog-package"><%= check_box_tag "packages[]", pack["id"], false, disabled: !@catalog_result.online %><span><b><%= pack["name"] %></b><small><%= installed ? (update ? "UPDATE AVAILABLE" : "INSTALLED") : "NOT INSTALLED" %></small></span></label><% end %></div></section><% end %></div><%= submit_tag "DOWNLOAD SELECTED", class: "button button-light", disabled: !@catalog_result.online %><% end %></section></div>
