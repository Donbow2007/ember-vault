<header class="topbar">
  <%= link_to root_path, class: "brand", aria: { label: "Ember Vault home" } do %>
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="brand-type"><strong>EMBER</strong><b>VAULT</b></span>
  <% end %>
  <nav class="primary-nav" aria-label="Primary navigation">
    <%= link_to "Command", root_path, class: ("active" if controller_name == "dashboard") %>
    <% @navigation_modules.each do |mod| %>
      <%= link_to mod[:name], mod[:path], class: [ "module-nav-link", ("active" if controller_name == mod[:controller]) ] %>
    <% end %>
    <%= link_to "Transfers", downloads_path, class: ("active" if controller_name == "downloads") %>
    <%= link_to "Packs", knowledge_packs_path, class: ("active" if controller_name == "knowledge_packs") %>
    <%= link_to "Field Intel", assistant_path, class: ("active" if controller_name == "assistant") %>
    <%= link_to "System", updates_path, class: ("active" if controller_name == "updates") %>
    <%= link_to "Terms", terms_path, class: ("active" if controller_name == "terms") %>
  </nav>
  <div class="network-state"><span></span> LOCAL SYSTEM <b>ONLINE</b></div>
</header>
