<% content_for :title, "Ember Vault — Preserve What Matters" %>
<div class="shell">
  <main>
    <section class="hero"><div class="hero-image" aria-hidden="true"></div><div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content"><p class="eyebrow"><span>EV—01</span> KNOWLEDGE SURVIVES</p><h1>When the signal<br>dies, <em>we don't.</em></h1><p class="hero-copy">Your complete offline survival archive. Search every page, preserve critical knowledge, and operate beyond the reach of the grid.</p>
        <%= form_with url: search_path, method: :get, class: "search-console", data: { turbo_frame: "search_results" } do |form| %><span class="search-icon" aria-hidden="true"></span><%= form.search_field :q, value: params[:q], placeholder: "SEARCH THE ENTIRE ARCHIVE...", aria: { label: "Search the entire archive" }, autocomplete: "off" %><kbd>ENTER</kbd><% end %>
        <div class="hero-actions"><%= link_to "OPEN ARCHIVE", "#archive", class: "button button-light" %><%= link_to "SETUP", setup_path, class: "button button-ghost", data: { turbo_frame: "_top" } %></div>
      </div>
      <div class="hero-status" aria-label="System status"><p>LAST SYNC <strong><%= Time.current.strftime("%H:%M:%S") %></strong></p><p>NODE <strong>EV-LOCAL-01</strong></p><p>UPLINK <strong class="warning">DISABLED</strong></p></div>
    </section>
    <turbo-frame id="search_results"><%= render "search_results" if @query.present? %></turbo-frame>
    <section class="dashboard" id="archive"><div class="section-heading"><div><p class="section-index">01 // ARCHIVE MODULES</p><h2>Critical knowledge.<br><span>Locally secured.</span></h2></div><p class="section-note">Every item indexed down to the paragraph.<br>No cloud. No tracking. No dependency.</p></div>
      <div class="module-grid"><% @modules.each_with_index do |mod, index| %><article class="module-card <%= "featured" if index.zero? %>"><div class="module-topline"><span><%= format("%02d", index + 1) %></span><b><%= mod[:status] %></b></div><div class="module-icon <%= mod[:icon] %>" aria-hidden="true"></div><h3><%= mod[:name] %></h3><p><%= mod[:description] %></p><footer><span><%= mod[:size] %></span><%= link_to "ENTER →", mod[:path] %></footer></article><% end %><% if @modules.empty? %><div class="empty-archive"><b>NO MODULES DOWNLOADED</b><p>Open Setup to secure archive content or offline map regions.</p><%= link_to "OPEN SETUP", setup_path, class: "button button-light" %></div><% end %></div>
    </section>
    <section class="intel" id="intel"><div class="intel-copy"><p class="section-index">02 // FIELD INTELLIGENCE</p><h2>Ask the archive.<br><span>Not the internet.</span></h2><p>Ember retrieves local guidance and cites every passage. When a local model is ready it turns that evidence into a field-ready answer; otherwise cited source mode remains available.</p><%= form_with url: assistant_path, method: :post, class: "terminal-prompt" do |form| %><span aria-hidden="true">›</span><%= form.search_field :question, placeholder: "explain how to purify water after a flood", aria: { label: "Ask the local archive" }, required: true, autocomplete: "off" %><%= form.submit "ASK" %><% end %></div><div class="intel-panel"><div class="panel-head"><span>LOCAL RETRIEVAL</span><b>READY</b></div><div class="radar" aria-hidden="true"><i></i><i></i><i></i><b></b></div><dl><div><dt>MODE</dt><dd><%= @ai_runtime.available? ? @ai_runtime.profile.upcase : "CITED SOURCES" %></dd></div><div><dt>MODEL FILE</dt><dd><%= @ai_runtime.model_path&.file? ? number_to_human_size(@ai_runtime.model_path.size) : "NOT LOADED" %></dd></div><div><dt>NETWORK</dt><dd>BLOCKED</dd></div></dl></div></section>
    <section class="system-strip" id="system"><% @metrics.each do |metric| %><div class="metric"><span><%= metric[:label] %></span><strong><%= metric[:value] %></strong><div><i style="width: <%= metric[:percent] %>%"></i></div></div><% end %><div class="metric system-theme"><span>DISPLAY MODE</span><strong><%= @theme.upcase %></strong><div class="system-theme-actions"><%= button_to "DARK", theme_setting_path, method: :patch, params: { theme: "dark" }, class: ("selected" if @theme == "dark") %><%= button_to "LIGHT", theme_setting_path, method: :patch, params: { theme: "light" }, class: ("selected" if @theme == "light") %></div></div></section>
  </main>
  <footer class="site-footer"><div class="footer-brand">EMBER VAULT <span>/</span> KEEP THE FIRE</div><p>LOCAL NODE EV-01 · <%= Time.current.year %> · NO TELEMETRY</p></footer>
</div>
