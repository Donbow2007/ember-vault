<% content_for :title, "Models — Ember Vault" %>
<main class="dashboard">
  <div class="section-heading"><div><p class="section-index">MODELS // LOCAL AI</p><h1>Ember models</h1></div></div>
  <div class="module-grid">
    <% @models.each do |model| %>
      <article class="module-card">
        <div class="module-topline"><span>GGUF</span><b><%= @installed_ids.include?(model.id) ? "INSTALLED" : "NOT INSTALLED" %></b></div>
        <h3><%= model.display_name %></h3>
        <p><%= model.repository %></p>
        <footer><span><%= model.status.to_s.upcase.tr("_", " ") %></span><span><%= model.license.to_s.upcase %></span></footer>
      </article>
    <% end %>
  </div>
</main>
