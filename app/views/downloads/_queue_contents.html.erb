<% active = downloads.any?(&:active?) %>
<div class="queue-status" data-downloads-active="<%= active %>"><span><i></i> LIVE TRANSFER TELEMETRY</span><small>UPDATES EVERY 2 SECONDS</small></div>
<div class="download-list">
  <% downloads.each do |download| %>
    <article>
      <div><small><%= download.kind.upcase %> // <%= download.resource_id %></small><h2><%= download.title %></h2><p><%= download.status.in?(%w[failed deletion_failed]) ? download.error_message : download.source_url %></p></div>
      <% meter = download.status.in?(%w[deleting deletion_failed]) ? download.deletion_progress : download.progress %>
      <div class="download-meter"><span><%= download.status.tr("_", " ").upcase %> · <%= meter %>%<%= " REMAINING" if download.status.in?(%w[deleting deletion_failed]) %></span><i><b style="width:<%= meter %>%"></b></i><small><% if download.status.in?(%w[deleting deletion_failed]) %><%= number_with_delimiter(download.deletion_remaining) %> / <%= number_with_delimiter(download.deletion_total) %> passages<% else %><%= number_to_human_size(download.downloaded_bytes) %> / <%= number_to_human_size(download.display_total_bytes) %><% end %></small><div class="download-actions"><% if download.status.in?(%w[queued downloading]) %><%= button_to "STOP", stop_download_path(download), class: "transfer-action" %><% elsif download.status.in?(%w[cancelled failed]) %><%= button_to "RESTART", retry_download_download_path(download), class: "transfer-action" %><% elsif download.status == "deletion_failed" %><%= button_to "RETRY DELETE", retry_deletion_download_path(download), class: "transfer-action danger" %><% end %><% unless download.status.in?(%w[deleting deletion_failed delete_requested]) %><%= button_to "DELETE", download_path(download), method: :delete, class: "transfer-action danger", form: { data: { turbo_confirm: "Delete this download, its files, and all associated search indexes?" } } %><% end %></div></div>
    </article>
  <% end %>
  <% if downloads.empty? %><div class="empty-archive"><b>TRANSFER QUEUE EMPTY</b><p>Open Setup to select public content packages.</p></div><% end %>
</div>
