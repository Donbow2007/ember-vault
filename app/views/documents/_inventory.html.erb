<% active = inventory.any? { |_created_at, type, item| type == :document ? item.status.in?(%w[queued indexing deleting]) : item.status == "deleting" } %>
<div data-downloads-active="<%= active %>">
  <% if inventory.any? %><div class="document-table">
    <% inventory.each do |_created_at, type, item| %>
      <% if type == :download %><% indexed_document = item.documents.first %><% map_index_count = item.kind == "map" ? item.map_features.count : nil %>
        <article class="inventory-download"><div class="file-glyph"><%= item.kind.upcase.first(4) %></div><div class="file-main"><h2><%= indexed_document && item.status == "complete" ? link_to(item.title, document_path(indexed_document)) : item.title %></h2><p>DOWNLOADED · <%= File.basename(item.destination_path.to_s) %> · <%= number_to_human_size(item.downloaded_bytes) %></p></div>
        <% if item.status.in?(%w[deleting deletion_failed]) %><span class="file-status failed"><%= item.status.tr("_", " ").upcase %></span><span class="download-meter"><i><b style="width:<%= item.deletion_progress %>%"></b></i><small><%= item.deletion_progress %>% REMAINING</small></span><% if item.status == "deletion_failed" %><%= button_to "RETRY DELETE", retry_deletion_download_path(item), class: "remove-button danger" %><% end %>
        <% else %><span class="file-status ready">DOWNLOADED</span><span class="index-state"><%= map_index_count ? pluralize(map_index_count, "MAP NAME") : (indexed_document ? pluralize(indexed_document.passage_count, "PASSAGE") : "NOT INDEXED") %></span><div class="index-actions"><% if item.kind.in?(%w[zim document]) %><%= button_to indexed_document ? "REINDEX" : "INDEX", index_content_download_path(item), class: "remove-button" %><% if indexed_document %><%= button_to "REMOVE INDEX", search_index_download_path(item), method: :delete, class: "remove-button danger", form: { data: { turbo_confirm: "Remove all searchable passages for #{item.title}? The downloaded file will be kept." } } %><% end %><% else %><%= link_to "OPEN MAP", map_path(item), class: "remove-button" %><%= button_to "REINDEX MAP", reindex_map_path(item), class: "remove-button" %><% end %></div><% end %></article>
      <% else %>
        <article class="inventory-document"><div class="file-glyph"><%= File.extname(item.original_filename).delete(".").first(4).upcase %></div><div class="file-main"><h2><%= item.deleting? ? item.title : link_to(item.title, document_path(item)) %></h2><p><%= item.status == "deletion_failed" ? item.error_message : "IMPORTED · #{item.original_filename} · #{number_to_human_size(item.byte_size)}" %></p></div><span class="file-status <%= item.status %>"><%= item.status.tr("_", " ").upcase %></span>
        <% if item.status.in?(%w[deleting deletion_failed]) %><span class="download-meter"><i><b style="width:<%= item.deletion_progress %>%"></b></i><small><%= item.deletion_progress %>% REMAINING</small></span><% if item.status == "deletion_failed" %><%= button_to "RETRY DELETE", retry_deletion_document_path(item), class: "remove-button danger" %><% end %><% else %><span><%= pluralize(item.passage_count, "PASSAGE") %></span><%= button_to "REMOVE", document_path(item), method: :delete, class: "remove-button", form: { data: { turbo_confirm: "Remove this document and its search index?" } } %><% end %></article>
      <% end %>
    <% end %>
  </div><% else %><div class="empty-archive"><b>NO DOCUMENTS SECURED</b><p>Import a file or complete a setup download to create the first archive entry.</p></div><% end %>
</div>
