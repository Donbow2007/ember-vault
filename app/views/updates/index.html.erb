<% content_for :title, "System Updates — Ember Vault" %>
<% content_for :head do %><%= tag.meta http_equiv: "refresh", content: "4" if @status[:state].in?(%w[queued running]) %><% end %>
<main class="update-shell">
  <header class="update-header"><p class="section-index">SYSTEM // RELEASE CONTROL</p><h1>Keep the vault<br><span>operational.</span></h1><p>Updates temporarily connect to GitHub, preserve all downloaded content and indexes, back up local databases, and roll back if the new server fails its health check.</p></header>
  <% flash.each do |type, message| %><div class="flash <%= type %>"><%= message %></div><% end %>
  <section class="update-console">
    <div class="update-version"><span>INSTALLED VERSION</span><strong>V<%= @update.current_version %></strong><small><%= @update.current_revision.first(12) %></small></div>
    <div class="update-state"><span>UPDATE STATUS</span><strong><%= (@status[:state] || "NOT CHECKED").upcase %></strong><p><%= @status[:message] || "Connect during setup or maintenance to check GitHub for a newer release." %></p><small><%= Time.zone.parse(@status[:updated_at]).strftime("%Y-%m-%d %H:%M:%S") if @status[:updated_at].present? %></small></div>
    <div class="update-controls"><%= button_to "CHECK GITHUB", check_updates_path, class: "button button-ghost" %><%= button_to "BACK UP + INSTALL", install_updates_path, class: "button button-light", disabled: @status[:state] == "running" %></div>
  </section>
  <aside class="update-warning"><b>POWER SAFETY</b><p>Do not disconnect power while an update is running. Downloaded ZIM files, maps, imported documents, search indexes, and settings are stored outside Git and are never replaced by the updater.</p></aside>
  <p><%= link_to "VIEW SAFETY DISCLAIMER & TERMS OF USE", terms_path, class: "button button-ghost" %></p>
</main>
